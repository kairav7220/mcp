# ── Nango v2 — Environment Variables ─────────────────────────────
# Copy this file to .env and fill in the values

# Nango encryption key (generate with: openssl rand -base64 32)
NANGO_ENCRYPTION_KEY=your-encryption-key-here

# Database credentials
NANGO_DB_USER=nango
NANGO_DB_PASSWORD=your-strong-db-password-here
NANGO_DB_HOST=nango-db
NANGO_DB_PORT=5432
NANGO_DB_NAME=nango

# Server config
SERVER_PORT=3003
CONNECT_UI_PORT=3009
NANGO_SERVER_URL=http://localhost:3003
NANGO_PUBLIC_SERVER_URL=http://localhost:3003
NANGO_PUBLIC_CONNECT_URL=http://localhost:3009

# Feature flags
FLAG_SERVE_CONNECT_UI=true
FLAG_AUTH_ENABLED=false
LOG_LEVEL=info

# CORS (both server and Connect UI)
NANGO_CORS_ORIGINS=http://localhost:3003,http://localhost:3009

# WebSocket path for Connect UI
NANGO_SERVER_WEBSOCKETS_PATH=/connect

# Records database (same as main DB for single-instance)
RECORDS_DATABASE_URL=postgresql://nango:your-strong-db-password-here@nango-db:5432/nango
