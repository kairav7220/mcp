# ════════════════════════════════════════════════════════════════════
# Environment Variables — Gateway + Control Plane (single .env)
# Copy to .env and fill in real values. NEVER commit .env.
# ════════════════════════════════════════════════════════════════════

# ── Database (Neon Postgres) ─────────────────────────────────────
DATABASE_URL='postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require'

# ── Redis (Upstash) ──────────────────────────────────────────────
REDIS_URL='rediss://default:PASSWORD@endpoint.upstash.io:6379'

# ── Nango self-hosted (Docker, ports per nango-selfhosted/.env) ──
NANGO_HOST=http://localhost:3003
NANGO_SECRET=generate-with-python-secrets-token_urlsafe-32

# ── Gateway ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
PORT=8000

# ── Abuse protection (Phase 2) ───────────────────────────────────
DAILY_QUOTA=5000               # Max calls per user per day (resets 00:00 UTC)
RATE_LIMIT_PER_MINUTE=60       # Max calls per API key per minute
PROVIDER_CAP_PER_HOUR=200      # Max calls per user per provider per hour
CIRCUIT_BREAKER_THRESHOLD=0.5  # Error rate (0-1) that trips the breaker
CIRCUIT_BREAKER_MIN_CALLS=5    # Min calls before breaker evaluates
CIRCUIT_BREAKER_WINDOW=60      # Error tracking window in seconds
CIRCUIT_BREAKER_COOLDOWN=120   # Seconds to block after breaker trips
MAX_CONNECTIONS_PER_USER=15    # Max Nango connections per user

# ── Control plane (Supabase Auth — login only, NOT our database) ─
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_ANON_KEY=anon-jwt-from-supabase-settings-api
SUPABASE_JWT_SECRET=legacy-jwt-secret-from-supabase-settings-api
APP_URL=https://your-control-plane.onrender.com
UI_URL=https://your-dashboard.onrender.com
